# =============================================================
# PawTrack - example environment file
# =============================================================
# Copy this file to ".env" and adjust it for your machine:
#
#     copy .env.example .env
#
# NEVER commit .env — it contains secrets. See .gitignore.
# =============================================================

# --- Session signing key ---
# Any long random string. Example: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# --- Email notifications ---
# Leave MAIL_USERNAME/MAIL_PASSWORD blank to run without sending email.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True

# --- Database storage ---
# OPTION A (easiest for local dev / UI work): leave DB_NAME blank.
#   The app will use the files in data/*.json and seed sample data.
# OPTION B (same as production): fill in these values and use MySQL/MariaDB
#   (e.g. XAMPP). DB_AUTO_CREATE creates the database/tables if missing.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=
DB_AUTO_CREATE=True

# --- Face ID login / HTTPS ---
# HTTP on 127.0.0.1 works for the camera on this computer only.
# Other devices / phones need HTTPS; see README ("Host it online for free").
PAWTRACK_HTTPS=False
PAWTRACK_HOST=127.0.0.1
PAWTRACK_WSGI=waitress
PAWTRACK_THREADS=8

# Optional HTTP Basic Auth gate (only enable for public hosting).
# Leave blank for normal local development.
PAWTRACK_GATE_USER=
PAWTRACK_GATE_PASSWORD=

# HTTPS only matters if PAWTRACK_HTTPS=True:
# PAWTRACK_SSL_CERT=certs/pawtrack.crt
# PAWTRACK_SSL_KEY=certs/pawtrack.key

# --- Face recognition tuning (InsightFace, CPU) ---
FACE_MODEL=buffalo_l
FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.05
FACE_MIN_DET_SCORE=0.50
FACE_CONSISTENCY_THRESHOLD=0.50
